# API Configuration
NODE_ENV=development
PORT=5001
CORS_ORIGIN=http://localhost:3000

# Database Configuration
MONGODB_URI=mongodb://mongo:27017/upivot

# Redis Configuration
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-here-generate-with-openssl-rand-hex-32
SESSION_SECRET=your-super-secure-session-secret-here-generate-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=upivot.sid

# OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
LINKEDIN_CLIENT_ID=your-linkedin-client-id-here
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret-here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Caching
CACHE_TTL_SECONDS=60

# Frontend Configuration  
VITE_API_URL=http://localhost:5001
